<?xml version="1.0" encoding="utf-8"?>
<!-- today_outline for a cell in the widget's left corners: there it follows
     the launcher's rounded outline, so the outline doesn't cut it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@android:color/white" />
    <corners
        android:radius="4dp"
        android:topLeftRadius="@android:dimen/system_app_widget_background_radius"
        android:bottomLeftRadius="@android:dimen/system_app_widget_background_radius" />
</shape>
